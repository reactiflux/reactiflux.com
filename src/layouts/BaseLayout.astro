---
import "@/styles/global.css";
import "@/styles/markdown.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = "The largest chat community of React developers.",
  wide = false,
} = Astro.props;
const containerClass = wide ? "max-w-5xl" : "max-w-4xl";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Reactiflux</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Reactiflux`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Reactiflux" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Space+Mono:wght@400;700&family=Work+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-body text-foreground bg-background">
    <nav class="border-b border-gray-200 px-6 py-4">
      <div class={`${containerClass} mx-auto flex items-center gap-6`}>
        <a href="/" class="font-heading font-bold text-lg">Reactiflux</a>
        <a href="/transcripts" class="hover:text-dark-pink">Transcripts</a>
        <a href="/blog" class="hover:text-dark-pink">Blog</a>
        <a href="/conduct" class="hover:text-dark-pink">Conduct</a>
      </div>
    </nav>
    <main class={`${containerClass} mx-auto px-6 py-8`}>
      <slot />
    </main>
    <footer class="border-t border-gray-200 px-6 py-6 mt-12">
      <div class={`${containerClass} mx-auto text-sm text-gray-500`}>
        &copy; {new Date().getFullYear()} Reactiflux
      </div>
    </footer>
  </body>
</html>
